  "_meta": {
    "format": "text_id ou text_id:pagina -> chave de voice_cast.json",
    "page_format": "decimal com 2 digitos, ex.: 1000:01",
    "note": "Use atribuicao por pagina quando um mesmo textId precisar de vozes diferentes.",
    "no_dub": "__no_dub__ = texto propositalmente sem voz (interface/sistema/instrucao nao dramatica)",
    "runtime_gender": "__runtime_npc_gender__ = textId reutilizado por NPC masculino e feminino; exige escolha em tempo de execução",
    "source_note": "Mapeamento Kokiri baseado no ator En_Ko do decomp zeldaret/oot e perfis de modelo KO_BOY/KO_GIRL; Saria baseada em En_Sa.",
    "progress_note": "Bloco 0x1000-0x10DF ampliado com En_Ko, En_Sa, En_Md, En_Skj, En_Dns, Kaepora e sequencias narrativas da Arvore Deku.",
    "progress_note_2": "Faixa 0x1000-0x10DF fechada; 100F e 1010 ficam com gênero resolvido em runtime.",
    "progress_note_3": "Bloco 0x2000-0x209F mapeado: Rancho Lon Lon, Castelo, Ganondorf, vendedor de máscara/guarda, Malon, Talon, Ingo, Zelda, Impa, Kaepora, corredor e textos sem dublagem.",
    "progress_note_4": "Bloco 0x3000-0x3073 fechado: Cidade Goron, Darunia, Link Goron, Fire Temple, Biggoron, Medigoron, Kaepora, narracao e mensagens de sistema.",
    "progress_note_5": "Bloco 0x4000-0x40B3 fechado: Domínio Zora, Ruto criança/adulta, Rei Zora, Sheik, Lago Hylia, cientista, mergulho, feijões, pesca, Pierre, Bonooru e sapos.",
    "runtime_flat_sharp": "__runtime_flat_sharp__ = Flat e Sharp compartilham o mesmo textId; escolher a voz pelo ator En_Poh/params em tempo de execução.",
    "progress_note_6": "Bloco 0x5000-0x508F fechado: Kakariko, Dampé, Flat/Sharp, Impa, Sheik, Guru-Guru, Cucco Lady, carpinteiros, velha das poções e NPCs.",
    "progress_note_7": "Bloco 0x6000-0x608F fechado: Fortaleza Gerudo, Nabooru, Koume/Kotake/Twinrova, arqueira Gerudo, carpinteiros, Deserto Assombrado, mercador do tapete, Kaepora e corredor.",
    "progress_note_8": "Sub-bloco 0x7000-0x707F fechado: Mercado/Castelo, Zelda criança, despertar de Link, Rauru, Sheik, revelação de Zelda, Ganondorf e lojas/minigames."
  },
